{
    "name": "webetdesign/faq-bundle",
    "description": "faq bundle",
    "type": "symfony-bundle",
    "license": "proprietary",
    "authors": [
        {
            "name": "Web&Design",
            "homepage": "https://www.webetdesign.com"
        }
    ],
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/webetdesign/wd-sortable-bundle.git"
        }
    ],
    "require": {
        "php": "^8.2",
        "doctrine/common": "^2.11 || ^3.1",
        "doctrine/doctrine-bundle": "^1.12 || ^2.0",
        "doctrine/orm": "^2.6.4 || ^3.0",
        "doctrine/inflector": "^2.0 || ^1.1",
        "a2lix/translation-form-bundle": "^3.0",
        "knplabs/doctrine-behaviors": "^2.0",
        "webetdesign/wd-sortable-bundle": "^6.4.0",
        "stof/doctrine-extensions-bundle": "^1.3",
        "symfony/config": "^6.4",
        "symfony/dependency-injection": "^6.4",
        "symfony/doctrine-bridge": "^6.4",
        "symfony/event-dispatcher": "^6.4",
        "symfony/expression-language": "^6.4",
        "sonata-project/admin-bundle": "4.* || ^3.45",
        "symfony/filesystem": "^6.4",
        "symfony/twig-bundle": "^6.4",
        "symfony/twig-bridge": "^6.4",
        "symfony/form": "^6.4",
        "symfony/yaml": "^6.4"
    },
    "require-dev": {
        "symfony/phpunit-bridge": "^6.2"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "WebEtDesign\\FaqBundle\\": "src/"
        }
    }
}
